# Общие артефакты и временные файлы
.DS_Store
Thumbs.db
*.log
*.tmp
*.swp
*.swo

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node / фронтенд
node_modules/
dist/

# Build artifacts (но не scripts/build/ — там скрипты сборки)
build/
!scripts/build/

# IDE
.idea/
.vscode/
*.iml

# ISO и образы
*.iso
*.img
*.qcow2

# Временные директории
temp/
soft/

# Сгенерированная копия scripts/ai в профиле (создаётся build-vibe-arch.sh)
archiso-vibelinux/airootfs/opt/
# AUR package cache (seeds from /srv/vibe-aur-cache, created by build-vibe-arch.sh)
archiso-vibelinux/airootfs/root/aur-cache/
# nlsh artifacts copied into profile by build-vibe-arch.sh (canonical: soft/nlsh/)
archiso-vibelinux/airootfs/root/nlsh/*.pkg.tar.zst
archiso-vibelinux/airootfs/root/nlsh/nlsh
!soft/nlsh/nlsh.desktop
!soft/nlsh/nlsh.svg

# AI assistants
.junie/
.qwen/
.qoder/

# Прочее
/.env
/.env.local

