# Общие артефакты и временные файлы
.DS_Store
Thumbs.db
*.log
*.tmp
*.swp
*.swo

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node / фронтенд
node_modules/
dist/

# Build artifacts (но не scripts/build/ — там скрипты сборки)
build/
!scripts/build/

# IDE
.idea/
.vscode/
*.iml

# ISO и образы
*.iso
*.img
*.qcow2

# Временные директории
temp/
soft/

# Сгенерированная копия scripts/ai в профиле (создаётся build-vibe-arch.sh)
archiso-vibelinux/airootfs/opt/
# AUR package cache (seeds from /srv/vibe-aur-cache, created by build-vibe-arch.sh)
archiso-vibelinux/airootfs/root/aur-cache/
# dmsh artifacts copied into profile by build-vibe-arch.sh (canonical: soft/dmsh/)
archiso-vibelinux/airootfs/root/dmsh/*.pkg.tar.zst
archiso-vibelinux/airootfs/root/dmsh/dmsh
!soft/dmsh/dmsh.desktop
!soft/dmsh/dmsh.svg

# Mini-профиль: dmsh-пакет и dmed-бинарник кладёт build-vibe-arch-minimal.sh
# (canonical: soft/dmsh/, soft/dmed/)
archiso-vibelinux-minimal/airootfs/root/dmsh/*.pkg.tar.zst
archiso-vibelinux-minimal/airootfs/root/dmsh/dmsh
archiso-vibelinux-minimal/airootfs/usr/local/

# AI assistants
.junie/
.qwen/
.qoder/

# Прочее
/.env
/.env.local

