# Сборочные артефакты (скачиваются/копируются при сборке ISO)
/archiso-vibelinux/airootfs/root/dmed/*
!/archiso-vibelinux/airootfs/root/dmed/dmed.png
/archiso-vibelinux/airootfs/root/dmsh/*.pkg.tar.zst
# dmcode: тянутся из GitHub-релизов при сборке; .desktop/.svg коммитим
/archiso-vibelinux/airootfs/root/dmcode/*.pkg.tar.zst
/archiso-vibelinux/airootfs/root/dmcode/dmcode
/archiso-vibelinux/airootfs/root/aur-cache/
/archiso-vibelinux/airootfs/root/koda/
/archiso-vibelinux/airootfs/opt/
/archiso-vibelinux-minimal/airootfs/root/dmsh/
/archiso-vibelinux-minimal/airootfs/root/dmcode/*.pkg.tar.zst
/archiso-vibelinux-minimal/airootfs/root/dmcode/dmcode
/archiso-vibelinux-minimal/airootfs/root/dmed/
# airootfs/usr держим в git (там лежат vibelinux-console-setup / vibelinux-gpm),
# игнорируем только то, что приносит сборка
/archiso-vibelinux-minimal/airootfs/usr/local/bin/dmed
/archiso-vibelinux-minimal/airootfs/usr/local/bin/dmed.real
/archiso-vibelinux-minimal/airootfs/usr/local/bin/vinstall
/archiso-vibelinux-minimal/airootfs/usr/local/share/vibelinux/
/out/
/scripts/legacy/build/
.qwen//freebsd-vibebsd/.pkglist.merged
/freebsd-vibebsd/.work/
/freebsd-vibebsd/.pkglist.merged
/*.core

# Локальные сборки (soft/*.pkg) — артефакты, не в git
/soft/*.pkg
# Локальные репозитории, живущие вне git-истории проекта
soft/nlsh/
