#!/usr/bin/env bash
# VibeLinux — настройка текстовой консоли (TTY): шрифт + раскладка.
#
# Зачем отдельный скрипт, если есть systemd-vconsole-setup: тот применяет
# FONT/KEYMAP из /etc/vconsole.conf один раз и очень рано, когда консоль ещё
# может быть на vgacon (он принимает не любую высоту шрифта). Плюс в UTF-8
# консоли нужен именно Unicode-вариант шрифта. Здесь мы:
#   * подбираем размер шрифта под текущее разрешение (1080p/1440p/4K и т.д.),
#     чтобы TTY не был ни микроскопическим, ни на 3 строки;
#   * берём ter-u* (маппинг KOI8-U): в нём есть вся русская кириллица
#     (64 заглавных + 32 строчных), полублоки и все двойные рамки ╔═╗║╚╝.
#     У ter-v* (маппинг xos4) на 512 глифов не хватает ходовых русских букв
#     (А, В, Г, Е, З, К, М, Н, О, Р, С, Т, Х и строчных а, е, к, о, п, р, с,
#     у, х) — в UTF-8 консоли они выводятся мусором;
#   * применяем ко всем VT и никогда не «падаем» (юнит не должен становиться
#     failed из-за того, что консоль ещё не готова).
#
# Флаги:
#   --font-only  только шрифт, без раскладки (для повторного применения из
#                shell: иначе каждый запуск fish сбрасывал бы группу на RU).
set -u

CONSOLEFONTS=/usr/share/kbd/consolefonts
VCONSOLE=/etc/vconsole.conf
FALLBACK=ter-u16b

# setfont/loadkeys меняют консоль через KDFONTOP/KDSKBMODE, а их ядро пускает
# только с CAP_SYS_TTY_CONFIG — то есть от root. Из-под пользователя (например,
# из fish при входе в TTY) сами по себе они молча ничего не сделают, поэтому
# перезапускаемся через sudo -n (в live у vibe NOPASSWD).
if (( EUID != 0 )); then
    command -v sudo >/dev/null 2>&1 || exit 0
    exec sudo -n "$(readlink -f "$0")" "$@"
fi

font_only=0
for arg in "$@"; do
    [[ $arg == --font-only ]] && font_only=1
done

# Высота фреймбуфера. На машинах с двумя GPU фреймбуферов бывает несколько
# (fb0/fb1) — берём максимальную высоту: крупный шрифт читаем на любом экране,
# а слишком крупный (3 строки на экран) — уже нет.
fb_height() {
    local f v best=0
    for f in /sys/class/graphics/fb*/virtual_size; do
        [[ -r $f ]] || continue
        v="$(tr -d '\n' <"$f")"
        v="${v#*,}"
        [[ $v =~ ^[0-9]+$ ]] || continue
        (( v > best )) && best=$v
    done
    if (( best == 0 )); then
        for f in /sys/class/graphics/fb*/modes; do
            [[ -r $f ]] || continue
            v="$(sed -n '1{s/.*x\([0-9]\{3,\}\)[a-z].*/\1/p}' "$f")"
            [[ $v =~ ^[0-9]+$ ]] || continue
            (( v > best )) && best=$v
        done
    fi
    (( best )) && printf '%s\n' "$best"
}

# Шрифт под высоту экрана. Высоты 18/20/28/32 проходят только на фреймбуфере:
# vgacon принимает лишь 8/16/20/24/32 (480/высота должно быть целым).
pick_font() {
    local h="$1"
    if   (( h >= 1300 )); then printf 'ter-u32b\n'
    elif (( h >= 1000 )); then printf 'ter-u28b\n'
    elif (( h >= 760  )); then printf 'ter-u20b\n'
    elif (( h >= 560  )); then printf 'ter-u18b\n'
    else                       printf '%s\n' "$FALLBACK"
    fi
}

apply_font() {
    local font="$1" dev ok=0
    for dev in /dev/tty1 /dev/tty2 /dev/tty3 /dev/tty4 /dev/tty5 /dev/tty6 /dev/tty0; do
        [[ -c $dev ]] || continue
        setfont -C "$dev" "$font" 2>/dev/null && ok=1
    done
    (( ok ))
}

apply_keymap() {
    local keymap dev
    keymap="$(sed -n 's/^KEYMAP=//p' "$VCONSOLE" 2>/dev/null | head -1 | tr -d '"')"
    [[ -n $keymap ]] || return 0
    # -C на каждый VT: без него loadkeys правит только активную консоль
    for dev in /dev/tty1 /dev/tty2 /dev/tty3 /dev/tty4 /dev/tty5 /dev/tty6 /dev/tty0; do
        [[ -c $dev ]] || continue
        loadkeys -C "$dev" "$keymap" 2>/dev/null || true
    done
}

font="$(pick_font "$(fb_height)")"
[[ -f $CONSOLEFONTS/$font.psf.gz ]] || font="$FALLBACK"

if ! apply_font "$font"; then
    # Консоль не приняла выбранный шрифт (например, vgacon + «неудобная»
    # высота) — пробуем безопасный 16px, он проходит везде.
    [[ $font == "$FALLBACK" ]] || apply_font "$FALLBACK" || true
fi
(( font_only )) || apply_keymap

exit 0
