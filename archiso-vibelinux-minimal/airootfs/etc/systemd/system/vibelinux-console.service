[Unit]
Description=VibeLinux — консольный шрифт под разрешение и раскладка RU/EN
DefaultDependencies=no
After=systemd-vconsole-setup.service
Before=getty@tty1.service

[Service]
Type=oneshot
# Подбор шрифта (ter-u*) под разрешение + раскладка. Скрипт всегда exit 0,
# чтобы в раннем boot юнит не уходил в failed из-за ещё не готовой консоли.
ExecStart=/usr/local/bin/vibelinux-console-setup

[Install]
# sysinit — как можно раньше, multi-user — повторно, уже после того как
# загрузились KMS-драйверы и fbcon успел сбросить шрифт на дефолтный.
WantedBy=sysinit.target
WantedBy=multi-user.target
