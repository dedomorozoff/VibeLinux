{
  "archinstall-language": "English",
  "hostname": "vibelinux",
  "kernels": ["linux"],
  "locale_config": {
    "kb_layout": "ru",
    "sys_enc": "UTF-8",
    "sys_lang": "ru_RU"
  },
  "bootloader": "Systemd-boot",
  "bootloader_config": {
    "bootloader": "Systemd-boot",
    "uki": false,
    "removable": false
  },
  "ntp": true,
  "swap": true,
  "timezone": "UTC",
  "audio_config": null,
  "network_config": {},
  "mirrors": {
    "Worldwide": [
      "https://mirror.rackspace.com/archlinux/$repo/os/$arch",
      "https://geo.mirror.pkgbuild.com/$repo/os/$arch"
    ]
  },
  "packages": [],
  "offline": false,
  "no_pkg_lookups": false,
  "silent": false,
  "script": "guided"
}
